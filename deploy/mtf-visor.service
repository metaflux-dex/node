# systemd unit for mtf-visor. Install to /etc/systemd/system/mtf-visor.service,
# then: systemctl daemon-reload && systemctl enable --now mtf-visor
#
# The outer supervisor here is systemd; the visor supervises the node. The visor
# exits 78 to signal an INTENTIONAL halt (e.g. an upgrade it cannot safely
# complete) — RestartPreventExitStatus stops systemd from papering over that.

[Unit]
Description=mtf-visor — MetaFlux node supervisor + auto-updater
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mtf-visor run --config /etc/mtf/visor.toml
Restart=on-failure
RestartSec=5
# 78 = intentional halt; it needs an operator, not an auto-restart loop.
RestartPreventExitStatus=78
# SIGTERM, then a grace window, then SIGKILL — long enough for the visor to drain
# the node cleanly. Keep this above the visor's shutdown_grace_secs.
TimeoutStopSec=45
KillSignal=SIGTERM
LimitNOFILE=1048576

# Run as a dedicated unprivileged user that owns the data + visor home.
User=mtf
Group=mtf
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mtf-visor /var/lib/mtf-node

[Install]
WantedBy=multi-user.target
